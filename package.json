{
  "name": "mstodo-bridge",
  "version": "0.2.0",
  "description": "MCP server for Microsoft To Do with a built-in admin web GUI. One command to deploy, built-in OAuth client, headless paste-back linking, Windows-friendly.",
  "type": "module",
  "bin": {
    "mstodo-bridge": "./dist/index.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/index.js",
    "auth:mstodo": "node dist/auth.js mstodo",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\""
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "tasks",
    "todo",
    "microsoft-todo",
    "outlook",
    "model-context-protocol",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "undici": "^8.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
