{
  "name": "mstodo-bridge",
  "version": "0.5.0",
  "description": "Local MCP server for Microsoft To Do. Chat-native login (click a link, paste the callback), built-in OAuth client, auto token refresh, Windows-friendly.",
  "type": "module",
  "bin": {
    "mstodo-bridge": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/index.js",
    "auth:mstodo": "node dist/auth.js mstodo",
    "test": "node -e \"fs.rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\""
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "tasks",
    "todo",
    "microsoft-todo",
    "outlook",
    "model-context-protocol",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "undici": "^6.28.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
